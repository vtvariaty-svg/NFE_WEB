DATABASE_URL="postgresql://postgres:password@localhost:5432/fiscalsaas?schema=public"
JWT_SECRET="YOUR_JWT_SECRET"
CRYPTO_MASTER_KEY="INCLUSIVE_32_BYTES_STRONG_KEY_000"

# ── Fiscal provider selection ────────────────────────────────────────────────
# sefaz_direct = emit via SEFAZ SOAP (default)
# nuvem_fiscal = emit via Nuvem Fiscal REST API (sandbox only in this phase)
FISCAL_PROVIDER=sefaz_direct

# ── Nuvem Fiscal ──────────────────────────────────────────────────────────────
# Toggle: set to 'true' to enable real Nuvem Fiscal API calls
NUVEM_FISCAL_ENABLED=false

# Environment: switch between 'sandbox' and 'production' without code changes
NUVEM_FISCAL_ENVIRONMENT=sandbox

# Base URL — change to production URL when ready
# Sandbox:    https://api.sandbox.nuvemfiscal.com.br
# Production: https://api.nuvemfiscal.com.br
NUVEM_FISCAL_BASE_URL=https://api.sandbox.nuvemfiscal.com.br

# OAuth2 token endpoint (same for both environments)
NUVEM_FISCAL_AUTH_URL=https://auth.nuvemfiscal.com.br/oauth/token

# OAuth2 credentials — never commit real values
NUVEM_FISCAL_CLIENT_ID=your_client_id
NUVEM_FISCAL_CLIENT_SECRET=your_client_secret

# OAuth2 scope — 'nfe' for NF-e; extend with 'nfse' if needed
NUVEM_FISCAL_SCOPE=nfe

# HTTP request timeout in milliseconds
NUVEM_FISCAL_TIMEOUT_MS=30000

# NF-e emission environment for the company (homologacao = test, producao = live)
# Must match what is configured via configureNfeService()
NUVEM_FISCAL_DEFAULT_AMBIENTE=homologacao

# Interval in ms for the async status sync worker (default: 60000 = 60s)
NUVEM_FISCAL_SYNC_INTERVAL_MS=60000
