generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String               @id @default(uuid())
  name          String
  slug          String               @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  users         User[]
  roles         Role[]
  companies     Company[]
  customers     Customer[]
  products      Product[]
  orders        Order[]
  invoices      Invoice[]
  certificates  Certificate[]
  nfeEvents     NfeEvent[]
  sefazLogs     SefazLog[]
  nfseConfigs   NfseMunicipalConfig[]
  nfseInvoices  NfseInvoice[]
  nfseEvents    NfseEvent[]
  nfseLogs      NfseProviderLog[]
  integrations  IntegrationAccount[]
  subscription  Subscription?
  usage         UsageCounter[]
  legalArchives LegalArchive[]
  auditLogs     AuditLog[]
  apiUsage      TenantApiUsage[]
  apiKeys       ApiKey[]
  idempotencyKeys IdempotencyKey[]
}

// ─── Tenant API Usage (daily counter for rate analytics and billing) ─────────
model TenantApiUsage {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  date         String   // 'YYYY-MM-DD'
  requests     Int      @default(0)
  lastEndpoint String?

  @@unique([tenantId, date])
}


model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  roleId        String?
  role          Role?          @relation(fields: [roleId], references: [id])
  isGlobalAdmin Boolean        @default(false)
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Role {
  id        String   @id @default(uuid())
  name      String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id       String  @id @default(uuid())
  document String  @unique // CNPJ
  name     String
  ie       String? // Inscrição Estadual
  cnae     String? // Classificação Nacional de Atividades Econômicas
  crt      String? // Código de Regime Tributário (1-Simples Nacional, 2-Simples Nacional Ecesso, 3-Regime Normal)

  // Address info required for NFe
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String? // UF
  zipCode    String? // CEP
  ibgeCode   String? // Código IBGE do município
  phone      String?
  email      String? // Email para comunicações fiscais
  cPais      String  @default("1058") // Brasil
  xPais      String  @default("Brasil")

  tpAmbDefault String @default("2") // 1-Produção, 2-Homologação

  // Contingência SVC-AN / SVC-RS
  contingenciaAtiva    Boolean  @default(false)
  tpEmisContingencia   String?  // 6=SVC-RS, 7=SVC-AN
  motivoContingencia   String?
  dhContingencia       String?

  isActive   Boolean   @default(true)
  archivedAt DateTime?

  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  certificates Certificate[]
  nfeInvoices  Invoice[]
  nfeEvents    NfeEvent[]
  sefazLogs    SefazLog[]
  nfseConfigs  NfseMunicipalConfig[]
  nfseInvoices NfseInvoice[]
  nfseEvents   NfseEvent[]
  nfseLogs     NfseProviderLog[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Certificate {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  certType     String    @default("A1")
  pfxEncrypted String // AES Encrypted PFX
  pfxIv        String // AES IV
  pfxSalt      String // AES Salt
  thumbprint   String?
  validFrom    DateTime?
  validTo      DateTime?
  isActive     Boolean   @default(true)
  revokedAt    DateTime?
  label        String?   // optional friendly name e.g. "Certificado 2025"

  logs      CertificateLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CertificateLog {
  id            String      @id @default(uuid())
  certificateId String
  certificate   Certificate @relation(fields: [certificateId], references: [id])
  tenantId      String
  action        String      // UPLOADED, RENEWED, REVOKED, USED_FOR_SIGNING, USED_FOR_TLS, EXPIRED_BLOCKED
  detail        String?
  ipAddress     String?
  createdAt     DateTime    @default(now())
}

model Customer {
  id       String  @id @default(uuid())
  document String // CPF or CNPJ
  name     String
  type     String  @default("FISICA") // "FISICA" or "JURIDICA"
  ie       String? // Inscrição Estadual (Isento, ou o número)
  im       String? // Inscrição Municipal (para NFSe)
  email    String?

  // Address info required for NFe
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String? // UF
  zipCode    String? // CEP
  ibgeCode   String? // Código IBGE do município
  phone      String?

  isActive   Boolean   @default(true)
  archivedAt DateTime?

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, document])
}

model Product {
  id    String  @id @default(uuid())
  name  String
  price Float
  sku   String?

  // Fiscal Data
  ncm  String? // Nomenclatura Comum do Mercosul
  cest String? // Código Especificador da Substituição Tributária
  cfop String? // Código Fiscal de Operações e Prestações Padrão
  unit String  @default("UN") // UN, KG, CX, LT

  // Tax definitions templates (Simples Nacional)
  icmsCst    String? // ex: 102, 103, 400
  pisCst     String? // ex: 99, 49
  cofinsCst  String? // ex: 99, 49
  icmsOrigin String  @default("0") // 0-Nacional, 1-Estrangeira, etc

  isActive   Boolean   @default(true)
  archivedAt DateTime?

  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Order {
  id         String      @id @default(uuid())
  total      Float
  status     String      @default("PENDING")
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  items      OrderItem[]
  invoices   Invoice[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Invoice {
  id     String @id @default(uuid())
  type   String // NFE or NFSE
  status String @default("DRAFT")

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  orderId  String?
  order    Order?  @relation(fields: [orderId], references: [id])
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])

  externalReference String?

  // NF-e 4.00 specifics
  serie   String?
  nnf     Int?
  cuf     String?
  cnf     String?
  chave44 String? @unique
  cdv     String?
  tpEmis  String? @default("1") // 1-Normal
  tpAmb   String? @default("2") // 1-Produção, 2-Homologação
  finNfe  String? @default("1") // 1-Normal

  xmlUnsigned   String? @db.Text
  xmlSigned     String? @db.Text
  xmlAuthorized String? @db.Text
  protNprot     String?
  protDhrecbto  String?
  rejectionCode String?
  rejectionMsg  String? @db.Text

  // ── External provider fields ──────────────────────────────────────────────
  // Populated when emission is handled by an external provider (e.g. Nuvem Fiscal).
  // Null for direct SEFAZ SOAP emissions.
  providerName      String?   // 'nuvem_fiscal' | 'sefaz_direct'
  providerInvoiceId String?   // UUID returned by the external provider
  providerStatus    String?   // Raw status string from provider (e.g. 'em_processamento')
  providerReference String?   // referencia sent to the provider (mirrors externalReference)

  items  NfeItem[]
  events NfeEvent[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  legalArchive LegalArchive?

  @@unique([tenantId, externalReference])
}

model Plan {
  id              String         @id @default(uuid())
  name            String // FREE, PRO
  planName        String?
  price           Float
  maxInvoices     Int
  maxIntegrations Int
  isActive        Boolean        @default(true)
  description     String?
  subscriptions   Subscription[]
}

model Subscription {
  id                   String    @id @default(uuid())
  tenantId             String    @unique
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  planId               String
  plan                 Plan      @relation(fields: [planId], references: [id])
  status               String    @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED, SUSPENDED
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime
  canceledAt           DateTime?
  suspendedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  history              BillingHistory[]
}

model BillingHistory {
  id              String       @id @default(uuid())
  tenantId        String
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  event           String       // ACTIVATED, RENEWED, UPGRADED, DOWNGRADED, CANCELED, SUSPENDED, PAYMENT_FAILED, PAYMENT_SUCCEEDED, REACTIVATED
  fromPlanId      String?
  toPlanId        String?
  amount          Float?
  stripeEventId   String?      @unique
  metadata        String?      @db.Text
  createdAt       DateTime     @default(now())
}


model UsageCounter {
  id        String @id @default(uuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  month     Int
  year      Int
  emissions Int    @default(0)

  @@unique([tenantId, month, year])
}

model LegalArchive {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  invoiceId String   @unique
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  xmlBase64 String
  pdfUrl    String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     String?
  action     String // e.g "ISSUED_NFE", "CANCELED_NFE"
  resourceId String? // Invoice ID
  metadata   String? // JSON stringified details
  createdAt  DateTime @default(now())
}

model NfeSequence {
  tenantId  String
  companyId String
  serie     String
  lastNnf   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([tenantId, companyId, serie])
}

model NfeItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  nitem     Int
  cprod     String
  xprod     String
  ncm       String
  cfop      String
  ucom      String
  qcom      Float
  vuncom    Float
  vprod     Float

  // Tax Info
  icmsCst   String?
  pisCst    String?
  cofinsCst String?
  icmsBase  Float?
  icmsRate  Float?
  icmsValue Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NfeEvent {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  eventType    String // CANCEL, CCE, INUTIL
  eventSeq     Int     @default(1)
  eventXmlSent String? @db.Text
  eventXmlResp String? @db.Text

  status    String  @default("PENDING")
  sefazCode String?
  sefazMsg  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SefazLog {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  invoiceId String?

  service     String // STATUS, AUTHORIZE, CANCEL, CCE, etc
  requestXml  String? @db.Text
  responseXml String? @db.Text
  httpStatus  Int?
  durationMs  Int?

  createdAt DateTime @default(now())
}

// ==========================================
// NFS-e MODULE
// ==========================================

model NfseProvider {
  id        String   @id @default(uuid())
  name      String
  type      String   // NATIONAL, ABRASF, OTHER
  configs   NfseMunicipalConfig[]
  invoices  NfseInvoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NfseMunicipalConfig {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  
  cmun      String   // Código IBGE Município
  uf        String
  
  providerId String
  provider   NfseProvider @relation(fields: [providerId], references: [id])
  
  environment  String // HOMOLOGATION, PRODUCTION
  endpointBase String?
  wsdlUrl      String?
  
  authMode     String // CERT_ONLY, TOKEN, LOGIN_MUNICIPAL
  credsEncrypted String? @db.Text // Encrypted credentials (user/password/token)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, companyId, cmun])
}

model NfseRpsSequence {
  tenantId  String
  companyId String
  serieRps  String
  lastRps   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([tenantId, companyId, serieRps])
}

model NfseInvoice {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  
  providerId String
  provider   NfseProvider @relation(fields: [providerId], references: [id])
  cmun       String

  serieRps  String
  numeroRps Int
  tipoRps   String

  loteId            String?
  protocolo         String?
  numeroNfse        String?
  codigoVerificacao String?

  status String @default("DRAFT") // DRAFT, SIGNED, SENT, PROCESSING, ISSUED, REJECTED, CANCELED, SUBSTITUTED

  payloadUnsigned String? @db.Text
  payloadSigned   String? @db.Text
  payloadSent     String? @db.Text
  payloadResponse String? @db.Text
  xmlNfse         String? @db.Text
  pdfUrl          String?

  rejectionCode String?
  rejectionMsg  String? @db.Text

  items  NfseItem[]
  taxes  NfseTax[]
  events NfseEvent[]

  substituteOfId String?
  substituteOf   NfseInvoice?  @relation("Substitution", fields: [substituteOfId], references: [id])
  substitutions  NfseInvoice[] @relation("Substitution")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NfseItem {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   NfseInvoice @relation(fields: [invoiceId], references: [id])

  codigoServicoMunicipal String?
  itemListaServico       String? // LC 116/2003
  cnae                   String?
  
  descricao     String
  quantidade    Float
  valorUnitario Float
  valorTotal    Float

  aliquotaIss   Float?
  valorIss      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NfseTax {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   NfseInvoice @relation(fields: [invoiceId], references: [id])

  issRetido             Boolean @default(false)
  baseCalculo           Float
  aliquota              Float
  valor                 Float
  deducoes              Float?
  descontoIncondicionado Float?
  descontoCondicionado   Float?
  valorLiquido          Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NfseEvent {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  invoiceId String?
  invoice   NfseInvoice? @relation(fields: [invoiceId], references: [id])

  eventType       String // CANCEL, SUBSTITUTE, OTHER
  eventPayloadSent String? @db.Text
  eventPayloadResp String? @db.Text

  status       String @default("PENDING")
  providerCode String?
  providerMsg  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NfseProviderLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  invoiceId String?

  operation      String // issue, cancel, query, status, batch, rps
  requestPayload String? @db.Text
  responsePayload String? @db.Text
  httpStatus     Int?
  durationMs     Int?

  createdAt DateTime @default(now())
}

// ─── Marketplace Integrations ────────────────────────────────────────────────

model IntegrationAccount {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  provider   String   // TIKTOK_SHOP, SHOPEE, MERCADOLIVRE
  shopId     String?  // External shop/store ID
  token      String   // Access token (encrypted at app level)
  refreshTk  String?  // Refresh token for OAuth flows
  expiresAt  DateTime?
  isActive   Boolean  @default(true)
  lastSyncAt DateTime?
  metadata   String?  @db.Text // JSON with extra config

  orders     MarketplaceOrder[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, provider, shopId])
}

model MarketplaceOrder {
  id                   String   @id @default(uuid())
  tenantId             String
  integrationAccountId String
  account              IntegrationAccount @relation(fields: [integrationAccountId], references: [id])

  externalOrderId String   // Marketplace order ID
  platform        String   // TIKTOK_SHOP, SHOPEE
  status          String   @default("SYNCED") // SYNCED, CONVERTED, FAILED
  rawPayload      String?  @db.Text // Full JSON from marketplace

  // Link to internal system
  orderId         String?  // Internal Order ID after conversion
  invoiceId       String?  // Invoice ID if auto-issued

  buyerName       String?
  totalAmount     Float?
  itemCount       Int?

  convertedAt     DateTime?
  createdAt       DateTime @default(now())

  @@unique([integrationAccountId, externalOrderId])
}

// ─── API Keys para Consumo Externo M2M ──────────────────────────────────
model ApiKey {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String   // Nome da integração: "Automation WhatsApp"
  prefix      String   // Primeiros 8 digitos: "sk_live_"
  keyHash     String   @unique // Hash SHA-256 da chave real
  hint        String   // ÚLTIMOS 4 digitos da chave: "4f2a" para exibição no UI
  
  scopes      String[] // Ex: ["nfe:issue", "nfe:read"] - Permissões granulares
  isActive    Boolean  @default(true)
  revokedAt   DateTime?
  expiresAt   DateTime?
  lastUsedAt  DateTime? // Rastreabilidade mínima de uso
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Controle de Idempotência ──────────────────────────────────────────
model IdempotencyKey {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  key             String   // The unique Idempotency-Key header value from client
  requestPath     String
  requestMethod   String
  requestBodyHash String   // Hex Hash of the RAW request body to detect mutations
  
  responseStatus  Int?
  responseBody    String?  @db.Text
  
  lockedAt        DateTime? // Lock timestamp. If lockedAt is > timeout, it expired
  expiresAt       DateTime  // TTL record
  createdAt       DateTime @default(now())

  @@unique([tenantId, key])
}
