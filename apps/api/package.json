        "@fastify/jwt": "latest",
        "@fastify/rate-limit": "latest",
        "@prisma/client": "^5.22.0",
        "@xmldom/xmldom": "^0.8.11",
        "dotenv": "latest",
        "fastify": "latest",
        "fastify-type-provider-zod": "latest",
        "node-forge": "^1.3.3",
        "stripe": "^20.3.1",
        "xml-crypto": "^6.1.2",
        "xmlbuilder2": "^4.0.3",
        "zod": "latest"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/node": "latest",
